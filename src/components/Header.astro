---
import { NAV_LINKS, SITE } from '../consts';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="border-b border-slate-200">
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4"
  >
    <a
      href="/"
      class="flex items-center gap-2 text-base font-semibold text-slate-900"
    >
      {
        /* TODO(brand): replace with the real logo asset. Brand direction will
          follow the companion guide app (guide.strictons.com). */
      }
      <span
        aria-hidden="true"
        class="inline-flex h-8 w-8 items-center justify-center rounded bg-slate-900 text-sm font-bold text-white"
        >S</span
      >
      <span>{SITE.name}</span>
    </a>

    <ul class="flex flex-wrap items-center gap-4 text-sm sm:gap-6">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class="text-slate-600 transition-colors hover:text-slate-900 aria-[current=page]:font-semibold aria-[current=page]:text-slate-900"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
