---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import '../styles/faq.css';

const faqGroups = [
  {
    id: 'for-hotels',
    heading: 'For hotels',
    items: [
      {
        q: 'Is it really free for the hotel?',
        a: [
          'Yes.',
          'There’s no cost to the hotel for the design, production or supply of the guide.',
          'The guide is funded by selected local businesses featured within it.',
        ],
      },
      {
        q: 'Who decides which businesses appear?',
        a: [
          'You do. Completely.',
          'We’ll put together an initial list to make things easy, but the hotel has complete control over who appears.',
          'Add any businesses you want. Remove any you don’t.',
          'Nothing goes into your guide without your approval.',
        ],
      },
      {
        q: 'Can we include businesses we already recommend?',
        a: [
          'Absolutely.',
          'If there are restaurants, bars, attractions or local businesses your team already recommends, they can be added to the guide.',
          'The business list is yours to shape around what you think is right for your guests.',
        ],
      },
      {
        q: 'What happens if we don’t like one of the businesses you suggest?',
        a: [
          'We remove it.',
          'The hotel has final say over every business in the guide. There’s no obligation to include a business simply because we’ve suggested it.',
        ],
      },
      {
        q: 'How much work is involved for our team?',
        a: [
          'Very little.',
          'We handle the business outreach, content, design, production, printing and ongoing management.',
        ],
      },
      {
        q: 'What do you need from us?',
        a: [
          'Your brand assets, essential information, what you would like featured inside the guide and your input on the businesses included.',
        ],
      },
      {
        q: 'How long does it take to create the guide?',
        a: [
          'Timing depends on the hotel and how quickly approvals come together.',
          'We’ll give you a clear production timeline at the beginning and manage the process from there.',
        ],
      },
      {
        q: 'Do we have to manage the live version?',
        a: [
          'No.',
          'There’s no new platform, dashboard or system for your team to manage.',
          'We build and maintain the live version alongside the physical guide.',
        ],
      },
      {
        q: 'Does it need to integrate with our existing systems?',
        a: [
          'No.',
          'The live version works independently.',
          'Where useful, it can simply link guests to systems you already use - your website, room service, spa bookings, entertainment, restaurant reservations or other guest services.',
          'Nothing needs to be replaced.',
        ],
      },
      {
        q: 'Can we make changes after the guide launches?',
        a: [
          'Yes.',
          'The live version can be updated as things change.',
          'If something affects the printed guide, we’ll work with you on the best way to handle it as part of the guide lifecycle.',
        ],
      },
      {
        q: 'What happens when we run low on guides?',
        a: [
          "We'll send you more.",
          "Simply let us know when you're running low and our team will arrange for replenishment.",
        ],
      },
      {
        q: 'Can we share the guide before guests arrive?',
        a: [
          'Yes.',
          'The live version can be linked from pre-arrival emails, booking confirmations or other guest communications so guests can start exploring before check-in.',
          'It can also support packages or experiences you’re promoting.',
        ],
      },
      {
        q: 'What can we see in the reporting?',
        a: [
          'QR scans give you a simple view of how guests are engaging with the guide.',
          'You can see where guests are taking the next step from the physical guide into the live version.',
        ],
      },
      {
        q: 'Does this replace reception or concierge?',
        a: [
          'No.',
          'It simply gives guests another easy way to discover what’s around them.',
          'Your team can keep making personal recommendations as they always have. The guide gives guests something useful to browse in their own time and take with them.',
        ],
      },
    ],
  },
  {
    id: 'for-businesses',
    heading: 'For businesses',
    items: [
      {
        q: 'How do I get into a hotel guide?',
        a: [
          'Businesses are selected for individual hotel guides based on the hotel, its location and what will be useful to its guests.',
          'Places are limited and offered by invitation.',
        ],
      },
      {
        q: 'Who decides whether my business is included?',
        a: [
          'The hotel does.',
          'Every hotel has complete control over the businesses appearing in its guide.',
          'They can add businesses they want represented and remove any they don’t.',
        ],
      },
      {
        q: 'How long does a placement run?',
        a: [
          'Placements generally run for 12 months.',
          'Your proposal will clearly set out the term before you commit.',
        ],
      },
      {
        q: 'What’s included with my placement?',
        a: [
          'Your placement in the physical guide, your own page in the live version, links that help guests take action, and monthly QR scan reporting.',
        ],
      },
      {
        q: 'Do I need to design the placement myself?',
        a: [
          'No.',
          'We design it for you so it fits naturally within the guide.',
          'We’ll ask for the information, imagery and brand assets we need, then take care of the rest.',
        ],
      },
      {
        q: 'Where does the QR code take guests?',
        a: [
          'Straight to your business in the live version of that hotel’s guide.',
          'From there, guests can get directions, make a booking, visit your website, browse an offer or find out more.',
        ],
      },
      {
        q: 'Can guests book directly with us?',
        a: [
          'Yes.',
          'If you already have a booking system, reservation page or enquiry process, we can send guests directly to it.',
        ],
      },
      {
        q: 'Do you take commission on bookings or sales?',
        a: [
          'No.',
          'Guests are directed to your own booking, contact or purchasing channels.',
        ],
      },
      {
        q: 'Can I include an offer for hotel guests?',
        a: [
          'Yes.',
          'If you have an offer that makes sense for guests, it can be included in the live version.',
        ],
      },
      {
        q: 'Can I update my information later?',
        a: [
          'Yes.',
          'If a booking link, website, offer, contact detail or other live information changes, let us know and we can update the live version.',
        ],
      },
      {
        q: 'How is performance measured?',
        a: [
          'Every business has its own QR code in the physical guide.',
          'We track those scans and send you a monthly report showing how many times guests scanned your placement to take the next step.',
        ],
      },
      {
        q: 'What does a scan tell me?',
        a: [
          'It tells you that a guest saw your placement in the physical guide and chose to find out more.',
          'It’s a simple way to see how often the guide is prompting guests to take the next step with your business.',
        ],
      },
      {
        q: 'Will other businesses like mine appear in the same guide?',
        a: [
          'Potentially.',
          'The hotel has complete control over the final business mix and decides what it wants included for its guests.',
        ],
      },
      {
        q: 'How much does a placement cost?',
        a: [
          'Pricing depends on the hotel, guide and placement.',
          'If you’re invited to feature, we’ll provide the relevant options and pricing upfront before you commit.',
        ],
      },
    ],
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqGroups.flatMap((group) =>
    group.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a.join(' '),
      },
    }))
  ),
};
---

<BaseLayout
  title="Frequently asked questions"
  description="Everything you might still be wondering about Strictons guides, for hotels and local businesses."
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  />

  <header class="faq-title" aria-labelledby="faq-heading">
    <div class="faq-shell">
      <h1 id="faq-heading">Frequently asked questions</h1>
    </div>
  </header>

  <div class="faq-shell faq-layout">
    <div class="faq-groups">
      {
        faqGroups.map((group) => (
          <section
            id={group.id}
            class="faq-group"
            aria-labelledby={`${group.id}-heading`}
          >
            <div class="faq-group-heading">
              <h2 id={`${group.id}-heading`}>{group.heading}</h2>
            </div>

            <div class="faq-list">
              {group.items.map((item) => (
                <details>
                  <summary>
                    <span>{item.q}</span>
                    <span class="faq-toggle" aria-hidden="true" />
                  </summary>
                  <div class="faq-answer">
                    {item.a.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <section class="faq-contact" aria-labelledby="faq-contact-heading">
    <div class="faq-shell faq-contact-inner">
      <div>
        <p class="faq-kicker">Still curious?</p>
        <h2 id="faq-contact-heading">Still have a question?</h2>
        <p>Get in touch and we’ll help.</p>
      </div>
      <a href="/contact">
        Get in touch
        <span aria-hidden="true">↗</span>
      </a>
      <a class="faq-email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </section>
</BaseLayout>
