---
import { Image } from 'astro:assets';
import { NAV_LINKS, SITE } from '../consts';
import logo from '../assets/strictons-logo.png';

interface Props {
  /**
   * Layer the header transparently over the home hero. The logo lockup sits
   * over the linen headline column on lg+ (dark) and over the artwork on
   * smaller screens (light), so its colours flip at `lg`. While the menu is
   * open the header bar sits on top of the dark menu panel and its marks are
   * forced light — see `header[data-nav-open]` in global.css.
   */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);
---

<header
  class:list={[
    'z-50',
    overlay
      ? 'absolute inset-x-0 top-0'
      : 'relative border-b border-slate-200 bg-white',
  ]}
>
  {
    /* Bar — stays above the menu panel at all times (local z-20 > panel z-10). */
  }
  <div
    class="relative z-20 mx-auto flex max-w-6xl items-center justify-between px-4 py-4"
  >
    <a
      href="/"
      aria-label={`${SITE.name} – home`}
      class="flex items-center gap-2.5"
    >
      <Image
        src={logo}
        alt=""
        width={80}
        height={93}
        densities={[1, 2]}
        class:list={[
          'nav-logo h-7 w-auto sm:h-8',
          overlay ? 'invert lg:invert-0' : '',
        ]}
      />
      <span
        class:list={[
          'nav-tint font-display text-lg tracking-[0.2em] uppercase sm:text-xl',
          overlay ? 'text-white lg:text-slate-900' : 'text-slate-900',
        ]}>{SITE.name}</span
      >
    </a>

    <button
      type="button"
      id="nav-toggle"
      aria-controls="primary-nav"
      aria-expanded="false"
      class:list={[
        'nav-tint -mr-2 inline-flex h-10 w-10 items-center justify-center rounded',
        overlay ? 'text-white' : 'text-slate-900',
      ]}
    >
      <span class="sr-only">Menu</span>
      <span class="hamburger" aria-hidden="true">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </span>
    </button>
  </div>

  {
    /*
    Full-screen menu. The curtain drop and the delayed content reveal live in
    global.css (#primary-nav / .nav-reveal), keyed off the data-open attribute.
  */
  }
  <div
    id="primary-nav"
    data-open="false"
    tabindex="-1"
    class="fixed inset-0 z-10 flex flex-col overflow-y-auto bg-artwork-blend text-white"
  >
    <nav
      aria-label="Primary"
      class="nav-reveal mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-4 pt-24 pb-24"
    >
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li class="border-b border-white/15 first:border-t">
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class="group block py-4 font-serif text-4xl tracking-tight text-white uppercase transition-colors hover:text-white/60 aria-[current=page]:text-white/50 sm:py-5 sm:text-6xl"
              >
                <span class="inline-block transition-transform duration-300 group-hover:translate-x-2">
                  {link.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <noscript>
    <style>
      #nav-toggle {
        display: none;
      }
      #primary-nav {
        position: static;
        visibility: visible;
        transform: none;
        background: #fff;
        color: #0f172a;
      }
      #primary-nav .nav-reveal {
        opacity: 1;
        transform: none;
      }
      #primary-nav a {
        color: #0f172a;
      }
      #primary-nav li {
        border-color: #e2e8f0;
      }
      #primary-nav .text-4xl {
        font-size: 1.5rem;
      }
    </style>
  </noscript>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('primary-nav');
  const header = toggle?.closest('header');

  if (toggle && panel && header) {
    // Focus trap spans the whole header: the bar's logo + toggle plus the
    // panel's links (the toggle doubles as the close button).
    const focusables = () =>
      Array.from(
        header.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
      ).filter((el) => el.getClientRects().length > 0);

    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        closeMenu();
        return;
      }
      if (e.key === 'Tab') {
        const items = focusables();
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };

    const openMenu = () => {
      header.dataset.navOpen = 'true';
      panel.dataset.open = 'true';
      toggle.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      document.addEventListener('keydown', onKeydown);
      // Focus the panel itself, not a link — nothing should look "selected".
      // The focus trap + Tab take over from here.
      requestAnimationFrame(() => panel.focus());
    };

    const closeMenu = () => {
      delete header.dataset.navOpen;
      panel.dataset.open = 'false';
      toggle.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      toggle.focus();
    };

    toggle.addEventListener('click', () =>
      panel.dataset.open === 'true' ? closeMenu() : openMenu()
    );
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a[href]')) closeMenu();
    });
  }
</script>
