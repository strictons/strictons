---
import { NAV_LINKS, SITE } from '../consts';
import logo from '../assets/strictons-logo.png';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);
---

<header data-site-header class="scroll-aware-header">
  <div class="evolution-banner">
    <div class="evolution-banner-track">
      <span>An evolution of the traditional hotel compendium</span>
    </div>
  </div>

  <div class="header-bar relative z-20">
    <a
      href="/"
      aria-label={`${SITE.name} home`}
      class="flex items-center gap-2.5 sm:gap-3"
    >
      <span
        aria-hidden="true"
        style={`--nav-logo-image: url("${logo.src}")`}
        class="nav-logo nav-tint"></span>
      <span
        class="nav-tint font-display text-lg tracking-[0.2em] uppercase sm:text-xl lg:text-2xl"
        >{SITE.name}</span
      >
    </a>

    <button
      type="button"
      id="nav-toggle"
      aria-controls="primary-nav"
      aria-expanded="false"
      class="nav-tint inline-flex h-11 w-11 items-center justify-center rounded sm:h-12 sm:w-12"
    >
      <span class="sr-only">Menu</span>
      <span class="hamburger" aria-hidden="true">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </span>
    </button>
  </div>

  {
    /*
    Full-screen menu. The curtain drop and the delayed content reveal live in
    global.css (#primary-nav / .nav-reveal), keyed off the data-open attribute.
  */
  }
  <div
    id="primary-nav"
    data-open="false"
    tabindex="-1"
    class="fixed inset-0 z-10 flex flex-col overflow-y-auto"
  >
    <nav
      aria-label="Primary"
      class="nav-reveal mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-4 pt-20 pb-12 sm:pt-24 sm:pb-16"
    >
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li class="border-b border-[#d8d5cb] first:border-t">
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class="nav-menu-link group block py-3 font-serif tracking-tight text-[#30332e] uppercase transition-colors hover:text-[#77715f] aria-[current=page]:text-[#77715f] sm:py-4"
              >
                <span class="inline-block transition-transform duration-300 group-hover:translate-x-2">
                  {link.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <noscript>
    <style>
      #nav-toggle {
        display: none;
      }
      #primary-nav {
        position: static;
        visibility: visible;
        transform: none;
        background: #fff;
        color: #0f172a;
      }
      #primary-nav .nav-reveal {
        opacity: 1;
        transform: none;
      }
      #primary-nav a {
        color: #0f172a;
      }
      #primary-nav li {
        border-color: #e2e8f0;
      }
      #primary-nav .text-4xl {
        font-size: 1.5rem;
      }
    </style>
  </noscript>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('primary-nav');
  const header = toggle?.closest('header');

  if (toggle && panel && header) {
    // Focus trap spans the whole header: the bar's logo + toggle plus the
    // panel's links (the toggle doubles as the close button).
    const focusables = () =>
      Array.from(
        header.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
      ).filter((el) => el.getClientRects().length > 0);

    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        closeMenu();
        return;
      }
      if (e.key === 'Tab') {
        const items = focusables();
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };

    const openMenu = () => {
      header.dataset.navOpen = 'true';
      panel.dataset.open = 'true';
      toggle.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      document.addEventListener('keydown', onKeydown);
      // Focus the panel itself, not a link; nothing should look "selected".
      // The focus trap + Tab take over from here.
      requestAnimationFrame(() => panel.focus());
    };

    const closeMenu = () => {
      panel.dataset.open = 'false';
      toggle.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      toggle.focus();
    };

    // Keep the header visually joined to the curtain until it has fully
    // retracted. Removing this state immediately causes a flash on close.
    panel.addEventListener('transitionend', (e) => {
      if (e.propertyName === 'transform' && panel.dataset.open === 'false') {
        delete header.dataset.navOpen;
      }
    });

    toggle.addEventListener('click', () =>
      panel.dataset.open === 'true' ? closeMenu() : openMenu()
    );
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a[href]')) closeMenu();
    });
  }
</script>

<script>
  const initialiseScrollHeader = () => {
    const header = document.querySelector<HTMLElement>('.scroll-aware-header');
    if (!header || header.dataset.scrollReady === 'true') return;

    header.dataset.scrollReady = 'true';
    let lastPosition = window.scrollY;
    let ticking = false;

    const updateHeader = () => {
      const currentPosition = Math.max(window.scrollY, 0);

      if (currentPosition < 72) {
        delete header.dataset.scrollElevated;
        delete header.dataset.scrollHidden;
        lastPosition = currentPosition;
      } else {
        header.dataset.scrollElevated = 'true';

        if (currentPosition > lastPosition + 8) {
          if (header.dataset.navOpen !== 'true') {
            header.dataset.scrollHidden = 'true';
          }
          lastPosition = currentPosition;
        } else if (currentPosition < lastPosition - 8) {
          delete header.dataset.scrollHidden;
          lastPosition = currentPosition;
        }
      }

      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateHeader);
      },
      { passive: true }
    );

    updateHeader();
  };

  initialiseScrollHeader();
  document.addEventListener('astro:page-load', initialiseScrollHeader);
</script>
