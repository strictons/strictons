---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureHero from '../components/FeatureHero.astro';
import { SITE } from '../consts';
import '../styles/contact.css';
---

<BaseLayout
  title="Contact"
  description="Book an on-site meeting with Strictons across NSW and the ACT, arrange a video call from anywhere or email guides@strictons.com."
>
  <FeatureHero
    headingId="contact-hero-heading"
    lines={["Let's meet to discuss", 'your dream guest', 'experience']}
    accentFrom={1}
  >
    <div class="contact-hero-details">
      <div class="contact-hero-links">
        <a href={`mailto:${SITE.email}`}>
          <span>Email</span>
          {SITE.email}
        </a>
        <a href="tel:+61259506402">
          <span>Phone</span>
          (02) 5950 6402
        </a>
      </div>

      <button
        id="load-calendar"
        type="button"
        aria-controls="booking-section"
        aria-expanded="true"
      >
        Book a meeting
        <span aria-hidden="true">↓</span>
      </button>
    </div>
  </FeatureHero>

  <section
    id="booking-section"
    class="contact-booking"
    aria-labelledby="booking-heading"
  >
    <div class="contact-booking-inner">
      <div class="contact-booking-heading">
        <p>Book a meeting</p>
        <h2 id="booking-heading">Choose a time that suits you.</h2>
        <p>
          Choose an on-site visit if you’re in NSW or the ACT, and we'll come to
          you. Or a video call from anywhere. Cal.com will send an invite.
        </p>
      </div>

      <div id="my-cal-inline-meet" class="contact-calendar"></div>

      <noscript>
        <p class="contact-booking-fallback">
          The booking widget needs JavaScript. Email <a
            href={`mailto:${SITE.email}`}>{SITE.email}</a
          > or call <a href="tel:+61259506402">(02) 5950 6402</a> and we’ll sort out
          a time.
        </p>
      </noscript>
    </div>
  </section>

  <script is:inline>
    const button = document.querySelector('#load-calendar');
    const bookingSection = document.querySelector('#booking-section');
    const calendar = document.querySelector('#my-cal-inline-meet');

    button?.addEventListener('click', () => {
      if (!bookingSection) return;
      bookingSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    if (calendar) {
      (function (C, A, L) {
        const queue = (api, args) => api.q.push(args);
        const document = C.document;
        C.Cal =
          C.Cal ||
          function () {
            const Cal = C.Cal;
            const args = arguments;
            if (!Cal.loaded) {
              Cal.ns = {};
              Cal.q = Cal.q || [];
              const script = document.createElement('script');
              script.src = A;
              script.async = true;
              script.addEventListener('error', () => {
                calendar.innerHTML =
                  '<p class="contact-calendar-error">The calendar could not load. Please email guides@strictons.com or call (02) 5950 6402.</p>';
              });
              document.head.append(script);
              Cal.loaded = true;
            }
            if (args[0] === L) {
              const api = (...apiArgs) => queue(api, apiArgs);
              const namespace = args[1];
              api.q = api.q || [];
              if (typeof namespace === 'string') {
                Cal.ns[namespace] = Cal.ns[namespace] || api;
                queue(Cal.ns[namespace], args);
                queue(Cal, ['initNamespace', namespace]);
              } else {
                queue(Cal, args);
              }
              return;
            }
            queue(Cal, args);
          };
      })(window, 'https://app.cal.com/embed/embed.js', 'init');

      window.Cal('init', 'meet', { origin: 'https://app.cal.com' });
      window.Cal.ns.meet('inline', {
        elementOrSelector: '#my-cal-inline-meet',
        config: {
          layout: 'month_view',
          useSlotsViewOnSmallScreen: 'true',
        },
        calLink: 'strictons/meet',
      });
      window.Cal.ns.meet('ui', {
        hideEventTypeDetails: false,
        layout: 'month_view',
      });
    }
  </script>
</BaseLayout>
