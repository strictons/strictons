---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/ContactCta.astro';
import customHotelGuides from '../assets/custom-hotel-guides-transparent-v2.png';
import '../styles/how-it-works.css';
---

<BaseLayout
  title="How It Works"
  description="A custom-branded Strictons guide, designed for your hotel at zero cost. See how the process works and what the guide does for your team."
>
  <section class="hotel-hero" aria-labelledby="hotel-hero-heading">
    <div class="hotel-hero-card">
      <div class="hotel-hero-copy">
        <h1 id="hotel-hero-heading">
          <span>A custom guide,</span>
          <span>made for you.</span>
        </h1>
        <h2 class="hotel-hero-subtitle">With surprisingly little work.</h2>
        <p class="mt-6 text-lg leading-relaxed text-[#f7efe7]">
          You approve the important things.<br />
          We handle everything else.
        </p>
        <p class="mt-5 font-semibold text-[#f7efe7]">
          No cost to the hotel. Fully managed by us.
        </p>
        <a class="hotel-hero-button" href="#hotel-process">
          See how it works
          <svg
            width="18"
            height="24"
            viewBox="0 0 18 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m4 5 5 5 5-5M4 13l5 5 5-5"
              stroke="currentColor"
              stroke-width="2"></path>
          </svg>
        </a>
      </div>

      <div class="hotel-hero-visual">
        <Image
          class="hotel-hero-image"
          src={customHotelGuides}
          alt="Three custom hotel guide cover concepts in navy, sage and cream."
          widths={[320, 480, 640, 800, 1024, 1280, 1536]}
          sizes="(max-width: 760px) calc(116vw - 92px), 890px"
          format="webp"
          quality={95}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section id="hotel-process" class="hotel-process">
    <div class="hotel-process-inner">
      <p class="hotel-process-kicker">How it works</p>

      <div class="hotel-process-overview">
        <div>
          <h2>From first meeting to print.</h2>
          <p class="hotel-process-timing">8 to 12 weeks, typically</p>
        </div>

        <div class="hotel-process-copy">
          <p>
            We start with a meeting to review the businesses that could appear.
            Our team will bring a proposed list, after conducting research on
            your hotel, your guest profile and the neighbourhood. You have
            complete control over the list. Add any businesses you would like
            and remove any you don’t. Nobody is contacted or included without
            your approval.
          </p>
          <p>
            From there, we need your brand assets, essential information and
            guidance on what you want featured inside the guide. We then write
            and design the guide.
          </p>
          <p>
            Once designed, you review it, request any edits and approve the
            final version before we send it to print.
          </p>
          <p>
            Most guides are completed within 8-12 weeks, depending on approvals
            and how quickly the business list comes together.
          </p>
        </div>
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
