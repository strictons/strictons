---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import customers from '../assets/customers.png';
import '../styles/business.css';
---

<BaseLayout
  title="For Business"
  description="Put your business in front of nearby hotel guests while they are deciding where to eat, drink, shop and explore."
>
  <section class="business-hero" aria-labelledby="business-hero-heading">
    <div class="business-hero-card">
      <div class="business-hero-visual">
        <Image
          class="business-hero-image"
          src={customers}
          alt="Travellers ready to spend at local businesses during their stay."
          widths={[320, 480, 640, 800, 960, 1024]}
          sizes="(max-width: 760px) 72vw, 460px"
          format="webp"
          quality={90}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      </div>
      <div class="business-hero-shade" aria-hidden="true"></div>

      <div class="business-hero-copy">
        <p class="business-hero-eyebrow">For Business</p>
        <h1 id="business-hero-heading">
          Your best customers are staying nearby <em>tonight.</em>
        </h1>
        <p class="business-hero-intro">
          Help hotels give guests a better local experience while putting your
          business in front of them as they decide where to go.
        </p>
        <p class="business-hero-closing">
          Right customer. Right time. Right place.
        </p>
      </div>
    </div>
  </section>

  <section class="business-section" aria-labelledby="business-need-heading">
    <div class="business-copy-grid">
      <h2 id="business-need-heading">
        A better stay. More customers through your door.
      </h2>
      <div class="business-copy">
        <p class="business-copy-label">The shared challenge</p>
        <p>
          Hotels want guests to discover great local places without the friction
          of searching and comparing. Businesses are paying for social media
          reach without knowing whether it brought anyone through the door.
        </p>
        <p class="business-copy-label">The outcome</p>
        <p>
          <strong
            >Give guests a trusted recommendation when they’re ready to choose,
            improving their stay while turning nearby intent into visits,
            bookings and measurable scans.</strong
          >
        </p>
        <p>Every QR scan is tracked and shared in a simple monthly report.</p>
      </div>
    </div>
  </section>

  <section class="business-final" aria-labelledby="business-final-heading">
    <div class="business-section-inner">
      <h2 id="business-final-heading">Be where your customers are deciding.</h2>
      <div class="business-copy">
        <p>
          Your next customer may already be staying down the road. Be there when
          they ask: <strong>Where should we go?</strong>
        </p>
        <p>
          <strong>Spots are limited and offered by invitation only.</strong>
        </p>
        <a class="business-enquire" href="/contact">
          Enquire about featuring your business.
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
