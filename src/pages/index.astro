---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HomeImage from '../components/HomeImage.astro';
import '../styles/home.css';
import { COPYRIGHT, SITE } from '../consts';

/*
  Structured data (JSON-LD) scaffolding: Organization schema.
  Placeholder values; wire real data in when branding is finalized.
  TODO(brand): logo, sameAs profiles, and description below are placeholders.
*/
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/favicon-512.png', SITE.url).href,
  description: SITE.description,
  email: SITE.email,
  sameAs: [
    // 'https://www.linkedin.com/company/strictons',
    // 'https://twitter.com/strictons',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: SITE.email,
    url: `${SITE.url}/contact`,
  },
};
---

<BaseLayout
  title="Pocket Hotel Guides for Better Guest Stays"
  description="Custom print and digital pocket guides that help hotel guests settle in, discover local experiences and enjoy a more memorable stay, at zero cost to the hotel. An evolution of the traditional hotel compendium."
  headerOverlay
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema)}
  />

  <div class="homepage">
    <Hero />

    <section
      id="how-it-works"
      class="story-section"
      aria-labelledby="welcome-heading"
    >
      <div class="home-container story-card">
        <h2 id="welcome-heading">
          Every guest wants to feel personally taken care of, <em
            >without a long check-in.</em
          >
        </h2>
        <HomeImage
          name="guest-arrival"
          alt="Guests arriving with their luggage at a hotel reception."
        />
        <div class="story-copy">
          <p>
            When travellers arrive, they have a<br />number of questions racing
            through their mind.
          </p>
          <ul class="story-list">
            <li>What time is check-out?</li>
            <li>Do they have a restaurant?</li>
            <li>Where is the nearest shopping centre?</li>
          </ul>
          <p class="story-closing">
            They’re tired, stressed and unfamiliar.<strong
              >They just want to get to their room.</strong
            >
          </p>
        </div>
      </div>
    </section>

    <section
      class="story-section story-section-team"
      aria-labelledby="team-heading"
    >
      <div class="home-container story-card story-card-reverse">
        <h2 id="team-heading">
          Your team wants to be <em>the perfect host.</em>
        </h2>
        <div class="story-copy">
          <p>But in a busy hotel...</p>
          <ul class="story-list">
            <li>Three more guests are waiting</li>
            <li>The phone is ringing</li>
            <li>A room needs help</li>
          </ul>
          <p class="story-closing">
            Staff want to give guests everything.<strong
              >They don’t always have the time.</strong
            >
          </p>
        </div>
        <HomeImage
          name="reception-team"
          alt="A busy hotel reception team welcoming guests and answering the phone."
        />
      </div>
    </section>

    <section
      class="story-section story-section-anticipate"
      aria-labelledby="anticipate-heading"
    >
      <div class="home-container story-card">
        <h2 id="anticipate-heading">
          Unanswered questions,<br />
          <em>can quickly compound.</em>
        </h2>
        <HomeImage
          name="uncertainty"
          alt="A newly arrived hotel guest looking uncertain while standing in an elevator with her luggage."
        />
        <div class="story-copy anticipate-copy">
          <p>
            One unanswered question. An amenity they can’t find.<br />Then
            something doesn’t go to plan.
          </p>
          <p>
            Individually, they're minor concerns. Together, they can become
            frustration, dissatisfaction and even a complaint.
          </p>
          <p class="story-closing">
            <strong
              >It’s hard to relax when they’re still figuring everything out.</strong
            >
          </p>
        </div>
      </div>
    </section>

    <section
      class="story-section story-section-solution"
      aria-labelledby="solution-heading"
    >
      <div class="home-container story-card story-card-reverse">
        <h2 id="solution-heading">
          Put everything a guest needs,<br />
          <em>right into their hands.</em>
        </h2>
        <div class="story-copy solution-copy">
          <p>
            With a custom designed,<br /> professionally printed.<strong
              class="solution-product"
              data-text="Pocket Hotel Guide.">Pocket Hotel Guide.</strong
            >
          </p>
        </div>
        <HomeImage
          name="guide-reception"
          alt="A hotel host handing a guest their branded pocket guide."
        />
      </div>
    </section>

    <section
      class="story-section story-section-experience"
      aria-labelledby="experience-heading"
    >
      <div class="home-container story-card">
        <h2 id="experience-heading">
          Once guests feel at ease,<br />
          <em>give them a great experience.</em>
        </h2>
        <HomeImage
          name="hotel-dining"
          alt="Guests enjoying dinner and wine by the water at sunset."
        />
        <div class="story-copy">
          <p>The best memories are often made beyond the hotel room.</p>
          <p>
            A restaurant you recommended. An afternoon at your spa. A local
            experience they would never have found themselves.
          </p>
          <p>When you lead them there, those memories attach to your hotel.</p>
          <p class="story-closing">
            <strong
              >Create a more memorable stay and give them a reason to come back
              and explore more</strong
            >
          </p>
        </div>
      </div>
    </section>

    <section
      class="story-section brand-section"
      aria-labelledby="brand-heading"
    >
      <div class="home-container brand-card">
        <h2 id="brand-heading">
          When their stay ends,<br />
          <em>your brand travels with them.</em>
        </h2>
        <div class="brand-intro">
          <p>Traditional compendiums stay in the room.</p>
          <p>Our guides are designed to be used on the go.</p>
          <p>Then taken home and used to plan again.</p>
        </div>
        <div class="brand-grid">
          <figure>
            <figcaption>From your hotel.</figcaption>
            <HomeImage
              name="hero-guide"
              alt="A guest reading a pocket guide while relaxing in a hotel room overlooking the water."
            />
          </figure>
          <figure>
            <figcaption>To their car.</figcaption>
            <HomeImage
              name="guide-car"
              alt="A hotel pocket guide beside a guest’s belongings on a car seat."
            />
          </figure>
          <figure>
            <figcaption>To their bookshelf.</figcaption>
            <HomeImage
              name="guide-bookshelf"
              alt="A hotel pocket guide kept on a bookshelf as a reminder of a memorable stay."
            />
          </figure>
        </div>
      </div>
    </section>

    <section
      class="story-section digital-section"
      aria-labelledby="digital-heading"
    >
      <div class="home-container story-card digital-card">
        <h2 id="digital-heading">
          And yes, there’s a <em>digital version too.</em>
        </h2>
        <HomeImage
          name="digital-guide"
          alt="A hotel guest opening a digital hotel guide on their phone."
        />
        <div class="story-copy digital-copy">
          <p>For the moments where digital works better.</p>
          <p>
            Guests can open it instantly for directions, booking links and
            offers.
          </p>
          <p class="story-closing">
            <strong
              >No app to download. No login required.<br />No maintenance from
              your team.</strong
            >
          </p>
        </div>
      </div>
    </section>

    <section
      class="story-section home-contact"
      aria-labelledby="contact-heading"
    >
      <div class="home-container home-contact-card">
        <div>
          <h2 id="contact-heading">Make every guest feel welcome.</h2>
          <p>
            Let’s create a pocket guide<br class="cta-mobile-break" /> for your hotel.
          </p>
        </div>
        <a class="home-button" href="/contact"
          >Get in touch <span aria-hidden="true">↗</span></a
        >
      </div>
    </section>

    <a class="back-to-top" href="#main" aria-label="Back to top">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6.5 14.5 5.5-5.5 5.5 5.5"></path>
      </svg>
    </a>

    <div class="home-copyright">{COPYRIGHT}</div>
  </div>

  <script>
    const initialiseHomeControls = () => {
      const homepage = document.querySelector<HTMLElement>('.homepage');
      if (!homepage || homepage.dataset.controlsReady === 'true') return;

      homepage.dataset.controlsReady = 'true';
      const backToTop = homepage.querySelector<HTMLElement>('.back-to-top');

      const updateBackToTop = () => {
        backToTop?.classList.toggle(
          'is-visible',
          window.scrollY > window.innerHeight * 0.85
        );
      };
      window.addEventListener('scroll', updateBackToTop, { passive: true });
      updateBackToTop();

      backToTop?.addEventListener('click', (event) => {
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: 'auto' });
      });
    };

    initialiseHomeControls();
    document.addEventListener('astro:page-load', initialiseHomeControls);
  </script>
</BaseLayout>
