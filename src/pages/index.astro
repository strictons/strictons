---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HomeImage from '../components/HomeImage.astro';
import ContactCta from '../components/ContactCta.astro';
import leftHandoff from '../assets/left-side-hero.png';
import relaxedStay from '../assets/relaxed-stay.png';
import zeroCost from '../assets/zero-cost.png';
import '../styles/home.css';
import { SITE } from '../consts';

/*
  Structured data (JSON-LD) scaffolding: Organization schema.
  Placeholder values; wire real data in when branding is finalized.
  TODO(brand): logo, sameAs profiles, and description below are placeholders.
*/
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/favicon-512.png', SITE.url).href,
  description: SITE.description,
  email: SITE.email,
  sameAs: [
    // 'https://www.linkedin.com/company/strictons',
    // 'https://twitter.com/strictons',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: SITE.email,
    url: `${SITE.url}/contact`,
  },
};
---

<BaseLayout
  title="Pocket Hotel Guides for Better Guest Stays"
  description="Custom print and digital pocket guides that help hotel guests settle in, discover local experiences and enjoy a more memorable stay, at zero cost to the hotel. An evolution of the traditional hotel compendium."
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema)}
  />

  <div class="homepage">
    <Hero />

    <section
      id="how-it-works"
      class="story-section"
      aria-labelledby="welcome-heading"
    >
      <div class="home-container story-card">
        <h2 id="welcome-heading">
          Every guest wants to feel personally taken care of <em
            >without a long check-in.</em
          >
        </h2>
        <HomeImage
          name="guest-arrival"
          alt="Guests arriving with their luggage at a hotel reception."
          depth
        />
        <div class="story-copy">
          <p>
            When travellers arrive, they have a<br />number of questions racing
            through their minds.
          </p>
          <ul class="story-list">
            <li>What time is check-out?</li>
            <li>Do they have a restaurant?</li>
            <li>Where is the nearest shopping centre?</li>
          </ul>
          <p class="story-closing">
            They’re tired, stressed and in unfamiliar surroundings.<strong
              >They just want to get to their room.</strong
            >
          </p>
        </div>
      </div>
    </section>

    <section
      class="story-section story-section-team"
      aria-labelledby="team-heading"
    >
      <div class="home-container story-card story-card-reverse">
        <h2 id="team-heading">
          Your team wants to be <em>the perfect host.</em>
        </h2>
        <div class="story-copy">
          <p>But in a busy hotel...</p>
          <ul class="story-list">
            <li>Three more guests are waiting</li>
            <li>The phone is ringing</li>
            <li>A room needs help</li>
          </ul>
          <p class="story-closing">
            Staff want to give guests everything.<strong
              >They don’t always have the time.</strong
            >
          </p>
        </div>
        <HomeImage
          name="reception-team"
          alt="A busy hotel reception team welcoming guests and answering the phone."
          depth
        />
      </div>
    </section>

    <section
      class="story-section story-section-anticipate"
      aria-labelledby="anticipate-heading"
    >
      <div class="home-container story-card">
        <h2 id="anticipate-heading">
          Unanswered questions<br />
          <em>can quickly compound.</em>
        </h2>
        <HomeImage
          name="uncertainty"
          alt="A newly arrived hotel guest looking uncertain while standing in an elevator with her luggage."
          depth
        />
        <div class="story-copy anticipate-copy">
          <p>
            One unanswered question. An amenity they can't find.<br /><br />Then
            something doesn't go to plan.
          </p>
          <p>
            Individually, it may be a minor concern.<br />Together, it can turn
            into frustration, dissatisfaction and even a complaint.
          </p>
          <p class="story-closing">
            <strong
              >It's hard for guests to relax<br />when they're still figuring
              everything out.</strong
            >
          </p>
        </div>
      </div>
    </section>

    <section
      class="story-section story-section-handoff"
      aria-labelledby="handoff-heading"
    >
      <div class="home-container handoff-card">
        <div class="handoff-guide-frame" aria-hidden="true">
          <Image
            class="handoff-guide"
            src={leftHandoff}
            alt=""
            widths={[480, 800, 1200, 1600]}
            sizes="(max-width: 760px) 100vw, 58vw"
            format="webp"
            quality={90}
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="handoff-copy">
          <h2 id="handoff-heading">
            One small change <em>for a more relaxed stay.</em>
          </h2>
          <p><strong>Hand your guests a guide at check-in.</strong></p>
        </div>

        <div class="handoff-guests-frame">
          <Image
            class="handoff-guests"
            src={relaxedStay}
            alt="Two hotel guests reading their pocket guide at reception."
            widths={[480, 800, 1200]}
            sizes="(max-width: 760px) 100vw, 58vw"
            format="webp"
            quality={90}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section
      class="story-section story-section-experience"
      aria-labelledby="experience-heading"
    >
      <div class="home-container story-card">
        <h2 id="experience-heading">
          Once guests feel at ease,<br />
          <em>show them a great experience</em>
        </h2>
        <HomeImage
          name="hotel-dining"
          alt="Guests enjoying dinner and wine by the water at sunset."
          depth
        />
        <div class="story-copy">
          <p>The best memories are often made beyond the hotel room.</p>
          <p>
            A restaurant you recommend. An afternoon at your spa. A local
            experience they might never have found.
          </p>
          <p class="story-closing">
            <strong
              >Create a more memorable stay and give them a<br />reason to come
              back and explore more.</strong
            >
          </p>
        </div>
      </div>
    </section>

    <section
      class="story-section brand-section"
      aria-labelledby="brand-heading"
    >
      <div class="home-container brand-card">
        <h2 id="brand-heading">
          When their stay ends,<br />
          <em>your brand travels with them.</em>
        </h2>
        <div class="brand-intro">
          <p>Traditional compendiums stay in the room.</p>
          <p>Our guides are designed to be used on the go.</p>
          <p>Then taken home and used to book again.</p>
        </div>
        <div class="brand-grid">
          <figure>
            <figcaption>From your hotel.</figcaption>
            <HomeImage
              name="hero-guide"
              alt="A guest reading a pocket guide while relaxing in a hotel room overlooking the water."
            />
          </figure>
          <figure>
            <figcaption>To their car.</figcaption>
            <HomeImage
              name="guide-car"
              alt="A hotel pocket guide beside a guest’s belongings on a car seat."
            />
          </figure>
          <figure>
            <figcaption>To their bookshelf.</figcaption>
            <HomeImage
              name="guide-bookshelf"
              alt="A hotel pocket guide kept on a bookshelf as a reminder of a memorable stay."
            />
          </figure>
        </div>
      </div>
    </section>

    <section
      class="story-section digital-section"
      aria-labelledby="digital-heading"
    >
      <div class="home-container story-card digital-card">
        <h2 id="digital-heading">
          And yes, we build a <em>digital version too.</em>
        </h2>
        <HomeImage
          name="digital-guide"
          alt="A hotel guest opening a digital hotel guide on their phone."
          depth
        />
        <div class="story-copy digital-copy">
          <p>For the moments when digital works better.</p>
          <p>
            Guests can open it instantly for directions, booking links and
            offers.
          </p>
          <p class="story-closing">
            <strong
              >No app to download. No login required.<br />No maintenance from
              your team.</strong
            >
          </p>
        </div>
      </div>
    </section>

    <section
      class="story-section zero-cost-section"
      aria-labelledby="zero-cost-heading"
    >
      <div class="home-container zero-cost-card">
        <div class="zero-cost-copy">
          <h2 id="zero-cost-heading">
            All for <em>zero cost</em><br />to your hotel.
          </h2>
          <p>
            Every guide is funded by sponsorships from local businesses. Every
            business is reviewed, recommended and approved by your team first.
          </p>
        </div>

        <div class="zero-cost-visual">
          <Image
            src={zeroCost}
            alt="Local hospitality, tourism and experience partners who help fund each hotel guide."
            widths={[480, 800, 1052]}
            sizes="(max-width: 760px) 100vw, 52vw"
            format="webp"
            quality={90}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <ContactCta />

    <a class="back-to-top" href="#main" aria-label="Back to top">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6.5 14.5 5.5-5.5 5.5 5.5"></path>
      </svg>
    </a>
  </div>

  <script>
    const initialiseHomeControls = () => {
      const homepage = document.querySelector<HTMLElement>('.homepage');
      if (!homepage || homepage.dataset.controlsReady === 'true') return;

      homepage.dataset.controlsReady = 'true';
      const backToTop = homepage.querySelector<HTMLElement>('.back-to-top');
      const depthScenes = Array.from(
        homepage.querySelectorAll<HTMLElement>('[data-depth-scene]')
      );

      const updateBackToTop = () => {
        backToTop?.classList.toggle(
          'is-visible',
          window.scrollY > window.innerHeight * 0.85
        );
      };
      window.addEventListener('scroll', updateBackToTop, { passive: true });
      updateBackToTop();

      backToTop?.addEventListener('click', (event) => {
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: 'auto' });
      });

      const reducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      );

      if (!reducedMotion.matches && depthScenes.length) {
        let frame = 0;
        const visibleScenes = new Set<HTMLElement>();

        const renderDepth = () => {
          frame = 0;
          const viewportHeight = window.innerHeight;

          visibleScenes.forEach((scene) => {
            const rect = scene.getBoundingClientRect();
            const sceneCentre = rect.top + rect.height / 2;
            const viewportCentre = viewportHeight / 2;
            const range = (viewportHeight + rect.height) / 2;
            const progress = Math.max(
              -1,
              Math.min(1, (sceneCentre - viewportCentre) / range)
            );

            const focus = 1 - Math.abs(progress);
            scene.style.setProperty('--scene-scroll-y', `${progress * -68}px`);
            scene.style.setProperty('--scene-scale', `${1.08 + focus * 0.055}`);
          });
        };

        const requestDepthFrame = () => {
          if (!frame) frame = window.requestAnimationFrame(renderDepth);
        };

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const scene = entry.target as HTMLElement;
              if (entry.isIntersecting) visibleScenes.add(scene);
              else visibleScenes.delete(scene);
            });
            requestDepthFrame();
          },
          { rootMargin: '15% 0px' }
        );

        depthScenes.forEach((scene) => {
          observer.observe(scene);

          scene.addEventListener('pointermove', (event) => {
            if (event.pointerType === 'touch') return;
            const rect = scene.getBoundingClientRect();
            const x = (event.clientX - rect.left) / rect.width - 0.5;
            const y = (event.clientY - rect.top) / rect.height - 0.5;
            scene.style.setProperty('--scene-pointer-x', `${x * 22}px`);
            scene.style.setProperty('--scene-pointer-y', `${y * 16}px`);
            scene.style.setProperty('--scene-rotate-x', `${y * -3.5}deg`);
            scene.style.setProperty('--scene-rotate-y', `${x * 4.5}deg`);
            scene.style.setProperty('--scene-light-x', `${(x + 0.5) * 100}%`);
            scene.style.setProperty('--scene-light-y', `${(y + 0.5) * 100}%`);
          });

          scene.addEventListener('pointerleave', () => {
            scene.style.setProperty('--scene-pointer-x', '0px');
            scene.style.setProperty('--scene-pointer-y', '0px');
            scene.style.setProperty('--scene-rotate-x', '0deg');
            scene.style.setProperty('--scene-rotate-y', '0deg');
            scene.style.setProperty('--scene-light-x', '50%');
            scene.style.setProperty('--scene-light-y', '36%');
          });
        });

        window.addEventListener('scroll', requestDepthFrame, { passive: true });
        window.addEventListener('resize', requestDepthFrame, { passive: true });
        requestDepthFrame();
      }
    };

    initialiseHomeControls();
    document.addEventListener('astro:page-load', initialiseHomeControls);
  </script>
</BaseLayout>
