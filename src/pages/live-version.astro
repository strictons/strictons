---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/ContactCta.astro';
import liveVersionQr from '../assets/live-version-qr.svg';
import '../styles/live-version.css';
---

<BaseLayout
  title="The Live Version"
  description="Every Strictons guide comes with a live version for directions, bookings, offers and useful hotel information, with no app or login required."
>
  <section class="live-hero" aria-labelledby="live-version-heading">
    <div class="live-hero-card">
      <div class="live-hero-copy">
        <h1 id="live-version-heading" class="live-eyebrow">The Live Version</h1>
        <h2 class="live-hero-title">A simple live version.</h2>
        <p>
          Every guide comes with an online version, giving guests a quick and
          easy way to act on what they discover in the physical guide.
        </p>
        <p>
          They can scan a QR code to make a booking, get directions, browse
          offers or find out more.
        </p>
        <p class="live-hero-closing">No app. No download. No login.</p>
      </div>
      <div class="live-hero-visual">
        <a
          class="live-hero-qr-frame"
          href="https://qrguide.co/bch/beachcomber"
          aria-label="Open the Beachcomber digital guide"
        >
          <img
            class="live-hero-qr"
            src={liveVersionQr.src}
            alt=""
            width="928"
            height="928"
            loading="eager"
            decoding="sync"
          />
        </a>
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
