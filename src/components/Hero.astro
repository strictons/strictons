---
import { Image } from 'astro:assets';
import artwork from '../assets/strictons-artwork-lillie-nolan.jpg';

/**
 * Home-page hero. Split layout:
 *   left  — white column, serif display headline
 *   right — full-bleed commissioned artwork with overlay tagline + credit
 *
 * On < lg the two columns stack (headline first, then artwork).
 *
 * TODO(content): headline, tagline, and a primary CTA below the headline are
 * placeholder brand copy — swap when real messaging is finalized.
 * TODO(fonts): `font-serif` is a system serif stack today; see global.css.
 */
---

<section aria-labelledby="hero-heading" class="border-b border-slate-200">
  <div class="grid lg:grid-cols-2">
    {/* Left — headline */}
    <div
      class="order-2 flex items-center px-6 py-14 sm:px-10 sm:py-20 lg:order-1 lg:px-14 lg:py-28 xl:px-20"
    >
      <div class="max-w-xl">
        <h1 id="hero-heading" class="font-serif text-slate-900">
          <span
            class="block text-lg font-medium tracking-[0.06em] text-slate-800 uppercase sm:text-2xl"
          >
            Professional. Thoughtful.
          </span>
          <span
            class="mt-1 block text-[2.75rem] leading-none font-bold tracking-[0.01em] uppercase sm:text-6xl lg:text-7xl"
          >
            Memorable.
          </span>
        </h1>
        {/* TODO(content): supporting sentence + primary CTA button go here. */}
      </div>
    </div>

    {/* Right — artwork */}
    <figure
      class="relative order-1 min-h-[440px] overflow-hidden bg-[#5a1f16] sm:min-h-[540px] lg:order-2 lg:min-h-[640px]"
    >
      <Image
        src={artwork}
        alt="Oil painting by Lillie Nolan of a hotel host handing a guest a teal Strictons guide at check-in."
        widths={[640, 960, 1280, 1920, 2400]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-[50%_42%]"
      />

      {
        /*
        Legibility overlays. Kept light so the artwork stays vivid:
        a soft vignette feathered from the left (behind the tagline) and a
        gentle bottom gradient (behind the credit). Text also carries a shadow.
      */
      }
      <div
        class="pointer-events-none absolute inset-0 [background:radial-gradient(120%_90%_at_0%_50%,rgba(0,0,0,0.42),rgba(0,0,0,0.12)_45%,transparent_70%)]"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/40 to-transparent"
      >
      </div>

      <p
        class="absolute top-1/2 right-6 left-6 -translate-y-1/2 font-serif text-lg font-bold tracking-[0.04em] text-white uppercase italic [text-shadow:0_2px_16px_rgba(0,0,0,0.6)] sm:right-8 sm:left-8 sm:text-2xl sm:tracking-[0.05em] 2xl:text-3xl"
      >
        Hand them a guide at check in
      </p>

      <figcaption
        class="absolute right-4 bottom-4 max-w-[16rem] text-right font-serif text-xs leading-relaxed text-white/90 italic [text-shadow:0_1px_10px_rgba(0,0,0,0.6)] sm:right-6 sm:bottom-6 sm:max-w-none sm:text-sm"
      >
        Artwork commissioned by Australian<br class="hidden sm:inline" />
        <span class="sm:hidden"> </span>artist Lillie Nolan &middot;
        <a
          href="https://www.instagram.com/lilliepaints"
          target="_blank"
          rel="noopener"
          class="underline decoration-white/40 underline-offset-2 hover:decoration-white"
          >@lilliepaints</a
        >
      </figcaption>
    </figure>
  </div>
</section>
