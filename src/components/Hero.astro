---
import { Image } from 'astro:assets';
import pocketHotelGuide from '../assets/pocket-hotel-guide.png';
---

<section class="home-hero product-hero" aria-labelledby="hero-heading">
  <div class="product-hero-card">
    <div class="product-hero-copy">
      <h1 id="hero-heading">
        Put everything a guest needs,<br />
        <em>right into their hands.</em>
      </h1>
      <p class="product-hero-intro">
        With a custom-designed,<br />professionally printed
        <strong>Pocket Hotel Guide.</strong>
      </p>
      <a class="home-button product-hero-button" href="#how-it-works">
        See how it works
        <svg
          width="18"
          height="24"
          viewBox="0 0 18 24"
          fill="none"
          aria-hidden="true"
          ><path
            d="m4 5 5 5 5-5M4 13l5 5 5-5"
            stroke="currentColor"
            stroke-width="2"></path></svg
        >
      </a>
    </div>

    <div class="product-hero-visual">
      <Image
        class="product-hero-cutout"
        src={pocketHotelGuide}
        alt="A hotel host handing a guest their branded pocket guide."
        widths={[320, 480, 640, 800, 1024]}
        sizes="(max-width: 760px) 62vw, (max-width: 1000px) 38vw, 430px"
        format="webp"
        quality={90}
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
