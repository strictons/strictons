---
import { Image } from 'astro:assets';
import artwork from '../assets/strictons-artwork-lillie-nolan.jpg';
import { COPYRIGHT } from '../consts';

/**
 * Home-page hero — full-viewport split.
 *   lg+   : linen headline column (left)  |  commissioned artwork (right)
 *   < lg  : artwork fills the screen; the (centred) headline sits above the
 *           tagline, both over the artwork
 *
 * The artwork "breathes": a slow Ken Burns drift on the painting plus a
 * scattering of warm light motes that rise and twinkle over it (all CSS,
 * disabled under prefers-reduced-motion — see global.css).
 *
 * The copyright line shows only on lg+ here; on mobile home there is none, and
 * inner pages get it from the slim footer in BaseLayout.
 *
 * The site header is layered over this section — see BaseLayout `headerOverlay`.
 * The artwork is set with `object-fill`: it always shows its full height and is
 * stretched horizontally to fill its column (no vertical cropping).
 *
 * TODO(content): headline, tagline and a primary CTA (below the headline) are
 * placeholder brand copy.
 * TODO(fonts): `font-serif` is a system serif stack today; see global.css.
 */

// Deterministic pseudo-random so the build output is stable.
const rand = (seed: number) => {
  const x = Math.sin(seed) * 10000;
  return x - Math.floor(x);
};
const round = (n: number, p = 1) => Math.round(n * 10 ** p) / 10 ** p;

const SPECKS = Array.from({ length: 16 }, (_, i) => {
  const s = i + 1;
  return {
    left: round(10 + rand(s * 12.9898) * 74),
    top: round(12 + rand(s * 78.233) * 64),
    size: round(2 + rand(s * 39.42) * 4),
    dur: Math.round(14 + rand(s * 27.17) * 18),
    delay: -Math.round(rand(s * 53.71) * 34),
    drift: Math.round(-38 + rand(s * 93.9) * 76),
    rise: Math.round(45 + rand(s * 11.13) * 100),
    peak: round(0.42 + rand(s * 61.4) * 0.4, 2),
  };
});

// A few large, very soft blooms — light welling up from inside the painting.
const GLOWS = Array.from({ length: 3 }, (_, i) => {
  const s = i + 1;
  return {
    left: round(18 + rand(s * 5.11) * 60),
    top: round(24 + rand(s * 17.7) * 46),
    size: Math.round(42 + rand(s * 8.3) * 52),
    dur: Math.round(20 + rand(s * 3.9) * 16),
    delay: -Math.round(rand(s * 21.4) * 24),
    drift: Math.round(-16 + rand(s * 14.2) * 32),
    rise: Math.round(18 + rand(s * 6.6) * 34),
    peak: round(0.06 + rand(s * 9.9) * 0.08, 2),
  };
});
---

<section
  aria-labelledby="hero-heading"
  class="relative min-h-svh overflow-hidden"
>
  {/* Artwork layer — full-bleed on mobile, right half on lg+ */}
  <figure class="absolute inset-0 overflow-hidden bg-[#5a1f16] lg:left-1/2">
    <Image
      src={artwork}
      alt="Oil painting by Lillie Nolan of a hotel host handing a guest a teal Strictons guide at check-in."
      widths={[640, 960, 1280, 1920, 2400]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-kenburns h-full w-full object-fill"
    />

    {/* Legibility overlays — must not intercept clicks */}
    <div
      class="pointer-events-none absolute inset-0 bg-black/25 lg:bg-transparent"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 [background:radial-gradient(60%_50%_at_50%_50%,rgba(0,0,0,0.4),transparent_72%)]"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-black/45 to-transparent lg:hidden"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/45 to-transparent"
    >
    </div>

    {
      /* Light coming off the painting — soft blooms + drifting motes. Decorative. */
    }
    <div class="hero-specks pointer-events-none" aria-hidden="true">
      {
        GLOWS.map((g) => (
          <span
            class="hero-glow"
            style={`left:${g.left}%;top:${g.top}%;width:${g.size}px;height:${g.size}px;--dur:${g.dur}s;--delay:${g.delay}s;--drift:${g.drift}px;--rise:${g.rise}px;--peak:${g.peak}`}
          />
        ))
      }
      {
        SPECKS.map((s) => (
          <span
            class="hero-speck"
            style={`left:${s.left}%;top:${s.top}%;width:${s.size}px;height:${s.size}px;--dur:${s.dur}s;--delay:${s.delay}s;--drift:${s.drift}px;--rise:${s.rise}px;--peak:${s.peak}`}
          />
        ))
      }
    </div>

    {
      /*
      Tagline. lg+: centred on the artwork. Mobile: sits just below the vertical
      midline, so it pairs with the headline (just above it) as a centred group.
    */
    }
    <p
      class="absolute inset-x-0 top-[calc(50%+1.25rem)] px-4 text-center font-serif text-lg font-bold tracking-[0.05em] text-white uppercase italic [text-shadow:0_2px_16px_rgba(0,0,0,0.65)] sm:px-8 sm:text-xl lg:top-1/2 lg:-translate-y-1/2 xl:text-2xl 2xl:text-3xl"
    >
      Hand them a guide at check in
    </p>

    <figcaption
      class="absolute right-6 bottom-8 text-right font-serif text-xs leading-relaxed text-white/90 italic [text-shadow:0_1px_10px_rgba(0,0,0,0.65)] sm:right-10 sm:bottom-10 sm:text-sm xl:right-12 2xl:right-20"
    >
      Artwork commissioned by Australian<br />
      Artist Lillie Nolan<br />
      @lilliepaints
    </figcaption>
  </figure>

  {
    /*
    Headline layer. On mobile it sits over the artwork (light text); on lg+ it
    has its own column with a subtle linen texture (dark text).
  */
  }
  <div class="pointer-events-none relative z-10 grid min-h-svh lg:grid-cols-2">
    <div
      class="relative flex flex-col px-6 text-white sm:px-10 lg:items-start lg:justify-center lg:bg-linen lg:px-10 lg:py-0 lg:text-slate-900 xl:px-12 2xl:px-20"
    >
      <h1
        id="hero-heading"
        class="absolute inset-x-0 bottom-[calc(50%+1.25rem)] mx-auto max-w-xl px-6 text-center font-serif sm:px-10 lg:static lg:mx-0 lg:px-0 lg:text-left"
      >
        <span
          class="block text-base font-medium tracking-[0.06em] text-white/90 uppercase [text-shadow:0_2px_14px_rgba(0,0,0,0.55)] sm:text-lg lg:text-xl lg:text-slate-700 lg:[text-shadow:none]"
        >
          Professional. Thoughtful.
        </span>
        <span
          class="mt-1 block text-[2.5rem] leading-none font-bold tracking-[0.01em] uppercase [text-shadow:0_2px_20px_rgba(0,0,0,0.55)] sm:text-5xl lg:[text-shadow:none] xl:text-6xl 2xl:text-7xl"
        >
          Memorable.
        </span>
      </h1>
      {
        /* TODO(content): supporting sentence + primary CTA (needs `pointer-events-auto`). */
      }

      {
        /* Copyright: desktop home only — mobile home has none, inner pages use the footer. */
      }
      <p
        class="absolute bottom-6 left-10 hidden text-xs tracking-wide text-slate-400 lg:block xl:left-12 2xl:left-20"
      >
        {COPYRIGHT}
      </p>
    </div>
  </div>
</section>
