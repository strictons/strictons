---
/**
 * BaseLayout: the shell every page renders into.
 *
 * Usage:
 *   <BaseLayout title="For Hotels" description="...">
 *     <Fragment slot="head"> ...JSON-LD / extra meta... </Fragment>
 *     <section>...page content...</section>
 *   </BaseLayout>
 */
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { COPYRIGHT } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image, type, noindex } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {title} {description} {image} {type} {noindex}>
      <slot name="head" />
    </BaseHead>
  </head>
  <body
    class="flex min-h-screen flex-col bg-white text-slate-900 antialiased"
    style={isHome ? 'background-color: #faf9f6;' : undefined}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-slate-900 focus:px-3 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class:list={['flex-1', !isHome && 'site-main-with-header']}>
      <slot />
    </main>
    {
      !isHome && (
        <footer class="border-t border-slate-200">
          <div class="mx-auto max-w-6xl px-6 py-6 text-center text-xs tracking-wide text-slate-500">
            {COPYRIGHT}
          </div>
        </footer>
      )
    }
  </body>
</html>
