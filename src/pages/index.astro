---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { SITE } from '../consts';

/*
  Structured data (JSON-LD) scaffolding — Organization schema.
  Placeholder values; wire real data in when branding is finalized.
  TODO(brand): logo, sameAs profiles, and description below are placeholders.
*/
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/favicon.svg', SITE.url).href,
  description: SITE.description,
  email: SITE.email,
  sameAs: [
    // 'https://www.linkedin.com/company/strictons',
    // 'https://twitter.com/strictons',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: SITE.email,
    url: `${SITE.url}/contact`,
  },
};
---

<BaseLayout
  title={SITE.name}
  description="Strictons builds digital guides for hotels and businesses. Placeholder marketing copy — real content to come."
  headerOverlay
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema)}
  />

  <Hero />
</BaseLayout>
