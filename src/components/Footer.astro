---
import { NAV_LINKS, SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 text-sm text-slate-600 md:flex-row md:items-center md:justify-between"
  >
    <p>&copy; {year} {SITE.name}. All rights reserved.</p>

    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-4 gap-y-2">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="hover:text-slate-900">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p>
      <a href={SITE.appUrl} class="font-medium text-slate-900 hover:underline">
        Open the guide app &rarr;
      </a>
    </p>
  </div>

  {
    /* TODO(analytics): analytics loader plugs in here (or in BaseLayout). None loaded yet. */
  }
</footer>
