---
import { Image } from 'astro:assets';
import artwork from '../assets/strictons-artwork-lillie-nolan.jpg';
---

<section class="home-hero" aria-labelledby="hero-heading">
  <div class="home-container hero-grid">
    <div class="hero-copy">
      <h1 id="hero-heading">
        <span class="hero-line">Do more, with less</span>
        <span class="hero-ampersand">&amp;</span>
        <span class="hero-line hero-line-accent">look after every guest.</span>
      </h1>
      <p>
        Hand them the information they need to settle in, and the inspiration to
        make the most out of their stay.
      </p>
      <a class="home-button" href="#how-it-works">
        See how it works
        <svg
          width="18"
          height="24"
          viewBox="0 0 18 24"
          fill="none"
          aria-hidden="true"
          ><path
            d="m4 5 5 5 5-5M4 13l5 5 5-5"
            stroke="currentColor"
            stroke-width="2"></path></svg
        >
      </a>
    </div>
    <figure class="hero-artwork">
      <div class="hero-artwork-frame">
        <div class="hero-artwork-surface">
          <Image
            src={artwork}
            alt="Painting of a hotel host handing a guest a teal pocket guide at check-in."
            widths={[480, 720, 960, 1280]}
            sizes="(max-width: 400px) 80vw, (max-width: 512px) calc(100vw - 80px), (max-width: 760px) 432px, 360px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
      <figcaption>
        <span>Artwork by Australian Artist Lillie Nolan · @lilliepaints</span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  let creditObserver: ResizeObserver | undefined;

  async function fitArtworkCredit() {
    creditObserver?.disconnect();
    await document.fonts.ready;
    const credit = document.querySelector<HTMLElement>(
      '.hero-artwork figcaption'
    );
    const text = credit?.querySelector<HTMLElement>('span');
    if (!credit || !text) return;

    let previousWidth = 0;
    const fit = () => {
      const availableWidth = credit.getBoundingClientRect().width;
      if (!availableWidth || availableWidth === previousWidth) return;
      previousWidth = availableWidth;
      // Preserve the previous size even though the displayed credit is shorter.
      const displayedCredit = text.textContent;
      text.textContent =
        'Artwork by Australian Artist Lillie Nolan · 2026 · @lilliepaints';
      text.style.fontSize = '100px';
      const naturalWidth = text.getBoundingClientRect().width;
      text.textContent = displayedCredit;
      if (naturalWidth) {
        text.style.fontSize = `${(92 * (availableWidth - 1)) / naturalWidth}px`;
      }
    };
    fit();
    creditObserver = new ResizeObserver(fit);
    creditObserver.observe(credit);
  }

  fitArtworkCredit();
  document.addEventListener('astro:page-load', fitArtworkCredit);
  document.addEventListener('astro:before-swap', () =>
    creditObserver?.disconnect()
  );
</script>
