---
import { NAV_LINKS, SITE } from '../consts';

interface Props {
  /**
   * Layer the header transparently over a full-bleed hero (home page).
   * The logo sits over the white headline column on lg+ and over the artwork
   * on smaller screens, so its colours flip at the `lg` breakpoint.
   */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname === href || pathname.startsWith(`${href}/`);
---

<header
  class:list={[
    'z-50',
    overlay
      ? 'absolute inset-x-0 top-0'
      : 'relative border-b border-slate-200 bg-white',
  ]}
>
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4"
  >
    <a
      href="/"
      class:list={[
        'flex items-center gap-2 text-base font-semibold',
        overlay ? 'text-white lg:text-slate-900' : 'text-slate-900',
      ]}
    >
      {
        /* TODO(brand): replace with the real logo asset. Brand direction will
          follow the companion guide app (guide.strictons.com). */
      }
      <span
        aria-hidden="true"
        class:list={[
          'inline-flex h-8 w-8 items-center justify-center rounded text-sm font-bold',
          overlay
            ? 'bg-white text-slate-900 lg:bg-slate-900 lg:text-white'
            : 'bg-slate-900 text-white',
        ]}>S</span
      >
      <span class={overlay ? 'drop-shadow-sm lg:drop-shadow-none' : ''}
        >{SITE.name}</span
      >
    </a>

    <ul class="flex flex-wrap items-center gap-4 text-sm sm:gap-6">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'transition-colors aria-[current=page]:font-semibold',
                overlay
                  ? 'text-white/90 drop-shadow-sm hover:text-white aria-[current=page]:text-white'
                  : 'text-slate-600 hover:text-slate-900 aria-[current=page]:text-slate-900',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
