---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

/*
  Contact: book a meeting through an embedded Cal.com scheduler (cal link
  "strictons/meet"). The visitor chooses an on-site visit or a video call inside
  the Cal.com flow; Cal.com handles the confirmation and the calendar invite.
  The embed snippet below is generated by Cal.com; keep it in an `is:inline`
  script so Astro leaves it untouched.
*/
---

<BaseLayout
  title="Contact"
  description="Book a meeting with Strictons: an on-site visit across NSW and the ACT, or a video call from anywhere. Or email guides@strictons.com."
>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <p class="text-sm font-semibold tracking-[0.08em] text-slate-500 uppercase">
      Contact
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
      We'd love 30 minutes of your time.
    </h1>

    <p class="mt-6 text-slate-600">
      <a class="underline" href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
      <a class="underline" href="tel:+61259506402">(02) 5950 6402</a>
    </p>

    <p class="mt-6 max-w-prose text-lg text-slate-600">
      Or select a time below. Choose an on-site visit if you're in NSW or the ACT,
      or a video call from anywhere. Cal.com will send an invite.
    </p>

    {/* Cal.com inline embed, calLink "strictons/meet". */}
    <div
      id="my-cal-inline-meet"
      class="mt-10"
      style="width:100%;min-height:600px;overflow:scroll"
    >
    </div>
    <script is:inline>
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
      Cal("init", "meet", {origin:"https://app.cal.com"});
      Cal.config = Cal.config || {};
      Cal.config.forwardQueryParams = true;

      Cal.ns.meet("inline", {
        elementOrSelector:"#my-cal-inline-meet",
        config: {"layout":"month_view","useSlotsViewOnSmallScreen":"true"},
        calLink: "strictons/meet",
      });

      Cal.ns.meet("ui", {"hideEventTypeDetails":false,"layout":"month_view"});
    </script>

    <noscript>
      <p class="mt-6 max-w-prose text-slate-600">
        The booking widget needs JavaScript. Email <a
          class="underline"
          href={`mailto:${SITE.email}`}>{SITE.email}</a
        > or call <a class="underline" href="tel:+61259506402"
          >(02) 5950 6402</a
        > and we'll sort out a time.
      </p>
    </noscript>
  </section>
</BaseLayout>
